rules_version = '2';

// Reglas de seguridad de Firestore para la app del entrenador.
// Pégalas en Firebase → Firestore Database → Reglas → Publicar.
//
// · El entrenador entra con Google y solo ve lo que lleva su uid.
// · El cliente entra de forma anónima con su enlace: al abrirlo, la app crea
//   clientes/{id}/accesos/{su uid} con el código del enlace. Si el código
//   coincide, ese móvil queda autorizado para su ficha y sus sesiones.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function esEntrenador() { return autenticado() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function cliente(cid) { return get(/databases/$(database)/documents/clientes/$(cid)).data; }
    function esDuenoDe(cid) { return autenticado() && cliente(cid).entrenadorUid == request.auth.uid; }
    function tieneAcceso(cid) {
      return autenticado() && exists(/databases/$(database)/documents/clientes/$(cid)/accesos/$(request.auth.uid));
    }

    match /plantillas/{id} {
      allow read, update, delete: if autenticado() && resource.data.entrenadorUid == request.auth.uid;
      allow create: if esEntrenador() && request.resource.data.entrenadorUid == request.auth.uid;
    }

    match /clientes/{cid} {
      allow read: if (autenticado() && resource.data.entrenadorUid == request.auth.uid) || tieneAcceso(cid);
      allow create: if esEntrenador() && request.resource.data.entrenadorUid == request.auth.uid;
      allow update: if (autenticado() && resource.data.entrenadorUid == request.auth.uid
                        && request.resource.data.entrenadorUid == request.auth.uid)
                    || (tieneAcceso(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alta']));
      allow delete: if autenticado() && resource.data.entrenadorUid == request.auth.uid;

      match /accesos/{uid} {
        allow read: if autenticado() && (request.auth.uid == uid || esDuenoDe(cid));
        allow create, update: if autenticado() && request.auth.uid == uid
                              && request.resource.data.codigo == cliente(cid).codigo;
        allow delete: if esDuenoDe(cid);
      }

      match /sesiones/{sid} {
        allow read, write: if esDuenoDe(cid) || tieneAcceso(cid);
      }
    }
  }
}
